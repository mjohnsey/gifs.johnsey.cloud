{
  "name": "stash.johnsey.cloud",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "author": "Michael Johnsey <mjohnsey@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply stash --local",
    "verify:urls": "tsx scripts/verify-urls.ts"
  },
  "dependencies": {
    "hono": "4.13.21",
    "jose": "6.2.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.9.1",
    "@cloudflare/workers-types": "5.20261123.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.23.0"
}
